# Copy this file to .env and fill in the values

# A long random string for signing session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# bcrypt hash of your chosen walker admin password
# Generate with: node -e "const b=require('bcrypt');b.hash('yourpassword',10).then(h=>console.log(h))"
WALKER_PASSWORD_HASH=

# Port to run the server on (defaults to 3000)
PORT=3000
